# Строка подключения к PostgreSQL
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Скупка: сервисный ключ приложения ВКонтакте для чтения открытых групп (необязательно)
VK_SERVICE_TOKEN=""
# Выключить сборщик объявлений: COLLECTOR=off
# Панель «Платформа»: email владельцев сервиса через запятую.
# Если не задано — панель видит владелец самой первой зарегистрированной мастерской.
# PLATFORM_ADMINS="you@example.ru"
# Выключить проверку сайта раз в минуту: MONITOR=off
# Реквизиты владельца площадки для документов (/legal/...)
# LEGAL_NAME="ИП Иванов Иван Иванович"
# LEGAL_INN="" LEGAL_OGRN="ОГРНИП ..." LEGAL_ADDRESS="" LEGAL_EMAIL="" LEGAL_PHONE=""
# SITE_URL="https://texnoskupka.ru"
