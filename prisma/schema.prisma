// Мультиарендная схема: каждая мастерская — отдельная компания (Company).
// Все бизнес-таблицы содержат companyId, а связи между ними идут через
// составные ключи (companyId, id). Поэтому база данных сама не даст привязать
// заказ одной компании к клиенту, складу или точке другой компании.
// Деньги хранятся в копейках (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MASTER
}

enum StatusKind {
  NEW
  IN_PROGRESS
  WAITING
  READY
  CLOSED
  CANCELED
}

enum ItemKind {
  SERVICE
  PART
}

enum PayMethod {
  CASH
  CARD
  TRANSFER
}

enum DictKind {
  DEVICE_TYPE
  BRAND
  MODEL
  COLOR
  EQUIPMENT
  APPEARANCE
  DEFECT
  ORDER_TYPE
}

enum StockMoveType {
  RECEIPT
  ORDER
  SALE
  ADJUST
  RETURN
  TRANSFER
  WRITEOFF
}

enum StockDocType {
  RECEIPT // оприходование от поставщика
  TRANSFER // перемещение между точками
  WRITEOFF // списание
  INVENTORY // инвентаризация
}

model Company {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  address      String?
  receiptTerms String? // текст условий в квитанции
  warrantyDays Int      @default(30)
  orderSeq     Int      @default(0)
  saleSeq      Int      @default(0)
  docSeq       Int      @default(0)
  createdAt    DateTime @default(now())

  locations      Location[]
  users          User[]
  clients        Client[]
  statuses       OrderStatus[]
  orders         Order[]
  orderItems     OrderItem[]
  orderEvents    OrderEvent[]
  services       Service[]
  products       Product[]
  stocks         Stock[]
  stockMoves     StockMove[]
  transactions   CashTransaction[]
  sales          Sale[]
  saleItems      SaleItem[]
  adSources      AdSource[]
  dictItems      DictItem[]
  orderFiles     OrderFile[]
  listingSources ListingSource[]
  productGroups  ProductGroup[]
  suppliers      Supplier[]
  stockDocs      StockDoc[]
  stockDocItems  StockDocItem[]
  cashShifts     CashShift[]
  listings       Listing[]
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  orders       Order[]
  stocks       Stock[]
  stockMoves   StockMove[]
  transactions CashTransaction[]
  sales        Sale[]
  stockDocs    StockDoc[]        @relation("DocFrom")
  stockDocsTo  StockDoc[]        @relation("DocTo")
  cashShifts   CashShift[]

  @@unique([companyId, id])
  @@index([companyId])
}

model User {
  id            String   @id @default(cuid())
  companyId     String
  locationId    String? // null — доступ ко всем точкам
  email         String   @unique
  name          String
  phone         String?
  passwordHash  String
  role          Role     @default(MASTER)
  salaryPercent Int      @default(0) // процент мастера от стоимости работ
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location        Location?         @relation(fields: [companyId, locationId], references: [companyId, id])
  sessions        Session[]
  ordersAsMaster  Order[]           @relation("OrderMaster")
  ordersAsAuthor  Order[]           @relation("OrderAuthor")
  ordersAsManager Order[]           @relation("OrderManager")
  events          OrderEvent[]
  transactions    CashTransaction[]
  stockMoves      StockMove[]
  sales           Sale[]
  listingsTaken   Listing[]         @relation("ListingAssignee")

  @@unique([companyId, id])
  @@index([companyId])
}

model Session {
  id          String   @id // sha256 от токена из cookie
  userId      String
  twoFactorOk Boolean  @default(false)
  locationId  String? // выбранная точка
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdSource {
  id        String  @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean @default(true)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients Client[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model Client {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  phone      String
  email      String?
  address    String?
  notes      String?
  adSourceId String?
  createdAt  DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adSource AdSource? @relation(fields: [companyId, adSourceId], references: [companyId, id])
  orders   Order[]
  sales    Sale[]

  @@unique([companyId, id])
  @@index([companyId, phone])
}

model OrderStatus {
  id        String     @id @default(cuid())
  companyId String
  name      String
  color     String     @default("#64748b")
  kind      StatusKind
  sort      Int        @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Order {
  id             String    @id @default(cuid())
  companyId      String
  locationId     String
  number         Int
  clientId       String
  statusId       String
  masterId       String?
  managerId      String?
  authorId       String
  orderType      String    @default("Платный")
  urgent         Boolean   @default(false)
  color          String?
  verdict        String? // вердикт / рекомендации клиенту
  discountPct    Int       @default(0)
  discountSum    Int       @default(0) // скидка в копейках
  deviceType     String
  brand          String?
  model          String?
  serial         String?
  problem        String
  equipment      String?
  appearance     String?
  notes          String?
  estimatedPrice Int?
  dueDate        DateTime?
  publicToken    String    @unique
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location          @relation(fields: [companyId, locationId], references: [companyId, id])
  client   Client            @relation(fields: [companyId, clientId], references: [companyId, id])
  status   OrderStatus       @relation(fields: [companyId, statusId], references: [companyId, id])
  master   User?             @relation("OrderMaster", fields: [companyId, masterId], references: [companyId, id])
  manager  User?             @relation("OrderManager", fields: [companyId, managerId], references: [companyId, id])
  author   User              @relation("OrderAuthor", fields: [companyId, authorId], references: [companyId, id])
  items    OrderItem[]
  events   OrderEvent[]
  payments CashTransaction[]
  files    OrderFile[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, statusId])
  @@index([companyId, clientId])
}

model OrderItem {
  id           String   @id @default(cuid())
  companyId    String
  orderId      String
  kind         ItemKind
  productId    String?
  serviceId    String?
  name         String
  qty          Int      @default(1)
  price        Int // цена для клиента за единицу, коп.
  cost         Int      @default(0) // себестоимость за единицу, коп.
  warrantyDays Int? // гарантия на позицию, дней
  createdAt    DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  product Product? @relation(fields: [companyId, productId], references: [companyId, id])
  service Service? @relation(fields: [companyId, serviceId], references: [companyId, id])

  @@index([companyId, orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  companyId String
  orderId   String
  userId    String?
  text      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  user    User?   @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([companyId, orderId])
}

model Service {
  id        String  @id @default(cuid())
  companyId String
  name      String
  price     Int
  isActive  Boolean @default(true)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  barcode     String?
  price       Int // розничная цена (продажа), коп.
  repairPrice Int? // ремонтная цена (в заказ), коп.
  minPrice    Int? // минимальная цена, ниже которой продавать нельзя, коп.
  cost        Int      @default(0) // средняя закупочная, коп.
  minQty      Int      @default(0)
  groupId     String?
  supplierId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group      ProductGroup?  @relation(fields: [companyId, groupId], references: [companyId, id])
  supplier   Supplier?      @relation(fields: [companyId, supplierId], references: [companyId, id])
  docItems   StockDocItem[]
  stocks     Stock[]
  moves      StockMove[]
  orderItems OrderItem[]
  saleItems  SaleItem[]
  listings   Listing[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Stock {
  id         String @id @default(cuid())
  companyId  String
  productId  String
  locationId String
  qty        Int    @default(0)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade)
  location Location @relation(fields: [companyId, locationId], references: [companyId, id])

  @@unique([companyId, productId, locationId])
}

model StockMove {
  id         String        @id @default(cuid())
  companyId  String
  productId  String
  locationId String
  userId     String?
  type       StockMoveType
  qty        Int // + приход, - расход
  cost       Int           @default(0) // закупочная цена единицы при приходе
  comment    String?
  createdAt  DateTime      @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade)
  location Location @relation(fields: [companyId, locationId], references: [companyId, id])
  user     User?    @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([companyId, productId])
}

model CashTransaction {
  id         String    @id @default(cuid())
  companyId  String
  locationId String
  userId     String?
  orderId    String?
  saleId     String?
  amount     Int // + приход, - расход, коп.
  method     PayMethod @default(CASH)
  category   String // "Оплата заказа", "Продажа", "Аренда" ...
  comment    String?
  createdAt  DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [companyId, locationId], references: [companyId, id])
  user     User?    @relation(fields: [companyId, userId], references: [companyId, id])
  order    Order?   @relation(fields: [companyId, orderId], references: [companyId, id])
  sale     Sale?    @relation(fields: [companyId, saleId], references: [companyId, id])

  @@index([companyId, locationId, createdAt])
}

model Sale {
  id         String   @id @default(cuid())
  companyId  String
  locationId String
  number     Int
  clientId   String?
  userId     String?
  total      Int // у возврата сумма отрицательная
  discount   Int      @default(0) // скидка на чек, коп.
  isReturn   Boolean  @default(false)
  returnOfId String? // возврат: исходная продажа
  createdAt  DateTime @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location     Location          @relation(fields: [companyId, locationId], references: [companyId, id])
  client       Client?           @relation(fields: [companyId, clientId], references: [companyId, id])
  user         User?             @relation(fields: [companyId, userId], references: [companyId, id])
  items        SaleItem[]
  transactions CashTransaction[]

  @@unique([companyId, id])
  @@unique([companyId, number])
}

model SaleItem {
  id        String @id @default(cuid())
  companyId String
  saleId    String
  productId String
  name      String
  qty       Int
  price     Int
  cost      Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Cascade)
  product Product @relation(fields: [companyId, productId], references: [companyId, id])

  @@index([companyId, saleId])
}

// Справочники для подсказок при приёмке: марки, модели, цвета, неисправности и т.д.
model DictItem {
  id        String   @id @default(cuid())
  companyId String
  kind      DictKind
  value     String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind, value])
  @@index([companyId, kind])
}

// Фото и файлы заказа. Хранятся в базе, чтобы попадать в ежедневный бэкап.
model OrderFile {
  id        String   @id @default(cuid())
  companyId String
  orderId   String
  name      String
  mime      String
  size      Int
  data      Bytes
  userId    String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, orderId])
}

// ---------- Скупка: источники объявлений, лента, выкуп ----------

enum ListingSourceKind {
  VK
  TELEGRAM
  AVITO
  YOULA
}

enum ListingStatus {
  NEW // пришло, никто не взял
  IN_WORK // сотрудник взял в работу
  BOUGHT // выкуплено
  REJECTED // не подошло
}

model ListingSource {
  id            String            @id @default(cuid())
  companyId     String
  kind          ListingSourceKind
  name          String
  url           String
  keywords      String            @default("") // через запятую; пусто — брать все посты
  stopWords     String            @default("") // через запятую; такие посты пропускаем
  isActive      Boolean           @default(true)
  lastCheckedAt DateTime?
  lastError     String?
  lastFound     Int               @default(0)
  createdAt     DateTime          @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([companyId, id])
  @@unique([companyId, url])
  @@index([companyId])
}

model Listing {
  id           String        @id @default(cuid())
  companyId    String
  sourceId     String? // null — добавлено вручную
  url          String
  title        String
  text         String        @default("")
  price        Int? // цена в объявлении, коп.
  photoUrl     String?
  postedAt     DateTime?
  status       ListingStatus @default(NEW)
  assigneeId   String?
  takenAt      DateTime?
  boughtAt     DateTime?
  buyPrice     Int? // за сколько выкупили, коп.
  productId    String? // товар на складе, созданный при выкупе
  rejectReason String?
  createdAt    DateTime      @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source   ListingSource? @relation(fields: [companyId, sourceId], references: [companyId, id])
  assignee User?          @relation("ListingAssignee", fields: [companyId, assigneeId], references: [companyId, id])
  product  Product?       @relation(fields: [companyId, productId], references: [companyId, id])

  @@unique([companyId, id])
  @@unique([companyId, url])
  @@index([companyId, status, createdAt])
  @@index([companyId, assigneeId])
}

// ---------- Склад: группы, поставщики, документы ----------

model ProductGroup {
  id        String  @id @default(cuid())
  companyId String
  name      String
  parentId  String?
  sort      Int     @default(0)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductGroup?  @relation("GroupTree", fields: [companyId, parentId], references: [companyId, id])
  children ProductGroup[] @relation("GroupTree")
  products Product[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  docs     StockDoc[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model StockDoc {
  id           String       @id @default(cuid())
  companyId    String
  number       Int
  type         StockDocType
  locationId   String
  toLocationId String?
  supplierId   String?
  userId       String?
  comment      String?
  total        Int          @default(0) // сумма по закупке, коп.
  createdAt    DateTime     @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location   Location       @relation("DocFrom", fields: [companyId, locationId], references: [companyId, id])
  toLocation Location?      @relation("DocTo", fields: [companyId, toLocationId], references: [companyId, id])
  supplier   Supplier?      @relation(fields: [companyId, supplierId], references: [companyId, id])
  items      StockDocItem[]

  @@unique([companyId, id])
  @@index([companyId, createdAt])
}

model StockDocItem {
  id        String @id @default(cuid())
  companyId String
  docId     String
  productId String
  name      String
  qty       Int // для инвентаризации — разница (факт минус учёт)
  cost      Int    @default(0)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doc     StockDoc @relation(fields: [companyId, docId], references: [companyId, id], onDelete: Cascade)
  product Product  @relation(fields: [companyId, productId], references: [companyId, id])

  @@index([companyId, docId])
}

// Кассовая смена на точке: открытие с остатком наличных, закрытие с пересчётом.
model CashShift {
  id           String    @id @default(cuid())
  companyId    String
  locationId   String
  openedById   String?
  closedById   String?
  openCash     Int       @default(0) // наличные на начало, коп.
  expectedCash Int? // по учёту на момент закрытия
  closeCash    Int? // пересчитали фактически
  comment      String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [companyId, locationId], references: [companyId, id])

  @@index([companyId, locationId, openedAt])
}
