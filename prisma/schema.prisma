// Мультиарендная схема: каждая мастерская — отдельная компания (Company).
// Все бизнес-таблицы содержат companyId, а связи между ними идут через
// составные ключи (companyId, id). Поэтому база данных сама не даст привязать
// заказ одной компании к клиенту, складу или точке другой компании.
// Деньги хранятся в копейках (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MASTER
}

enum StatusKind {
  NEW
  IN_PROGRESS
  WAITING
  READY
  CLOSED
  CANCELED
}

enum ItemKind {
  SERVICE
  PART
}

enum PayMethod {
  CASH
  CARD
  TRANSFER
}

enum DictKind {
  DEVICE_TYPE
  BRAND
  MODEL
  COLOR
  EQUIPMENT
  APPEARANCE
  DEFECT
  ORDER_TYPE
}

enum StockMoveType {
  RECEIPT
  ORDER
  SALE
  ADJUST
  RETURN
  TRANSFER
  WRITEOFF
}

enum StockDocType {
  RECEIPT // оприходование от поставщика
  TRANSFER // перемещение между точками
  WRITEOFF // списание
  INVENTORY // инвентаризация
  SUPPLIER_RETURN // возврат поставщику
}

model Company {
  id                    String    @id @default(cuid())
  name                  String
  phone                 String?
  address               String?
  receiptTerms          String? // текст условий в квитанции
  warrantyDays          Int       @default(30)
  orderSeq              Int       @default(0)
  saleSeq               Int       @default(0)
  docSeq                Int       @default(0)
  marketMargin          Int       @default(500000) // сколько хотим заработать на выкупе, коп.
  bonusFixed            Int       @default(0) // бонус сотруднику за каждый выкуп, коп.
  bonusPercent          Int       @default(0) // бонус в % от прибыли после продажи выкупленного
  avitoRegion           String    @default("rossiya") // регион Авито для оценки: часть ссылки avito.ru/<регион>
  // реквизиты (подставляются в печатные формы)
  email                 String?
  inn                   String?
  kpp                   String?
  ogrn                  String?
  director              String? // руководитель / лицо с правом подписи
  directorTitle         String?
  directorBasis         String? // «действует на основании»
  contract              String? // договор (номер, дата)
  bankName              String?
  bik                   String?
  swift                 String?
  corrAccount           String?
  account               String?
  companyNote           String? // доп. информация для бланков
  currency              String    @default("RUB")
  // цены
  salePriceKey          String    @default("retail") // какая цена ставится в продаже
  orderPriceKey         String    @default("repair") // какая цена ставится в заказе
  hideMinPrice          Boolean   @default(false)
  // статусы
  statusChains          Boolean   @default(false) // переходы только по цепочке
  barcodeSeq            Int       @default(0)
  // бонусная система: проценты в сотых долях (300 = 3%), суммы в копейках (1 балл = 1 ₽)
  salaryPeriodType      String    @default("MONTH") // MONTH или WEEK — расчётный период зарплаты
  salaryPeriodCount     Int       @default(1)
  salaryPeriodStart     DateTime? // начало первого периода
  bonusEnabled          Boolean   @default(false)
  bonusSalePct          Int       @default(300) // начисление с продаж
  bonusOrderPct         Int       @default(300) // начисление с выданных заказов
  bonusMinCheck         Int       @default(0) // минимальный чек для начисления
  bonusMaxPayPct        Int       @default(3000) // сколько процентов чека можно оплатить баллами
  bonusDelayDays        Int       @default(0) // баллы становятся доступны через N дней
  bonusExpireDays       Int       @default(0) // баллы сгорают через N дней, 0 — не сгорают
  bonusWelcome          Int       @default(0) // приветственные баллы при регистрации
  bonusAccrueOnBonusPay Boolean   @default(false) // начислять ли на часть, оплаченную баллами
  // платформа: доступ поддержки и приостановка
  supportUntil          DateTime? // до какого времени поддержка может войти в CRM
  supportWrite          Boolean   @default(false) // поддержке разрешено вносить изменения
  blockedAt             DateTime? // доступ приостановлен владельцем платформы
  createdAt             DateTime  @default(now())

  locations      Location[]
  users          User[]
  clients        Client[]
  statuses       OrderStatus[]
  orders         Order[]
  orderItems     OrderItem[]
  orderEvents    OrderEvent[]
  services       Service[]
  products       Product[]
  stocks         Stock[]
  stockMoves     StockMove[]
  transactions   CashTransaction[]
  sales          Sale[]
  saleItems      SaleItem[]
  adSources      AdSource[]
  dictItems      DictItem[]
  orderFiles     OrderFile[]
  listingSources ListingSource[]
  productGroups  ProductGroup[]
  suppliers      Supplier[]
  stockDocs      StockDoc[]
  stockDocItems  StockDocItem[]
  cashShifts     CashShift[]
  listings       Listing[]
  positions      Position[]
  warehouses     Warehouse[]
  cashboxes      Cashbox[]
  actionLogs     ActionLog[]
  marketPrices   MarketSnapshot[]
  priceTypes     PriceType[]
  supportLogs    SupportLog[]
  productPrices  ProductPrice[]
  printTemplates PrintTemplate[]
  salaryRules    SalaryRule[]
  salaryEntries  SalaryEntry[]
  cashTxLogs     CashTxLog[]
  saleTiles      SaleTile[]
  bonusTxs       BonusTx[]
}

model Location {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  address     String?
  phone       String?
  isActive    Boolean  @default(true)
  planRevenue Int      @default(0) // план выручки на месяц, коп.
  createdAt   DateTime @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses   Warehouse[]
  cashboxes    Cashbox[]
  users        User[]
  orders       Order[]
  stocks       Stock[]
  stockMoves   StockMove[]
  transactions CashTransaction[]
  sales        Sale[]
  stockDocs    StockDoc[]        @relation("DocFrom")
  stockDocsTo  StockDoc[]        @relation("DocTo")
  cashShifts   CashShift[]

  @@unique([companyId, id])
  @@index([companyId])
}

model User {
  id               String    @id @default(cuid())
  companyId        String
  locationId       String? // null — доступ ко всем точкам
  email            String    @unique
  name             String
  phone            String?
  passwordHash     String
  role             Role      @default(MASTER)
  positionId       String? // должность с набором прав
  salaryPercent    Int       @default(0) // процент мастера от стоимости работ (старое правило, если нет правил зарплаты)
  baseSalary       Int       @default(0) // оклад в месяц, коп.
  lastName         String?
  firstName        String?
  middleName       String?
  jobTitle         String? // должность по трудовому договору
  cashierInn       String?
  telegram         String?
  birthDate        DateTime?
  address          String?
  note             String?
  autoLogoutDays   Int? // выход из системы через N дней
  warehouseIds     String[]  @default([]) // доступные склады, пусто — все
  cashboxIds       String[]  @default([]) // доступные кассы, пусто — все
  defaultCashboxId String?
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  isActive         Boolean   @default(true)
  lastSeenAt       DateTime? // последний раз заходил в CRM
  createdAt        DateTime  @default(now())

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location        Location?         @relation(fields: [companyId, locationId], references: [companyId, id])
  position        Position?         @relation(fields: [companyId, positionId], references: [companyId, id])
  sessions        Session[]
  ordersAsMaster  Order[]           @relation("OrderMaster")
  ordersAsAuthor  Order[]           @relation("OrderAuthor")
  ordersAsManager Order[]           @relation("OrderManager")
  events          OrderEvent[]
  transactions    CashTransaction[]
  stockMoves      StockMove[]
  sales           Sale[]
  listingsTaken   Listing[]         @relation("ListingAssignee")
  actionLogs      ActionLog[]
  salaryRules     SalaryRule[]
  salaryEntries   SalaryEntry[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Session {
  id           String   @id // sha256 от токена из cookie
  userId       String
  twoFactorOk  Boolean  @default(false)
  locationId   String? // выбранная точка
  supportLogId String? // владелец платформы сейчас в режиме поддержки чужой компании
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdSource {
  id        String  @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean @default(true)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients Client[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model Client {
  id               String    @id @default(cuid())
  companyId        String
  name             String
  phone            String
  email            String?
  address          String?
  notes            String?
  adSourceId       String?
  // для договора купли-продажи (скупка) и документов
  birthDate        DateTime?
  passport         String? // серия и номер
  passportIssuedBy String?
  passportDate     DateTime?
  passportCode     String? // код подразделения
  inn              String?
  createdAt        DateTime  @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adSource  AdSource?  @relation(fields: [companyId, adSourceId], references: [companyId, id])
  orders    Order[]
  stockDocs StockDoc[]
  bonuses   BonusTx[]
  sales     Sale[]

  @@unique([companyId, id])
  @@index([companyId, phone])
}

model OrderStatus {
  id             String     @id @default(cuid())
  companyId      String
  name           String
  color          String     @default("#64748b")
  kind           StatusKind
  sort           Int        @default(0)
  widgetName     String? // как статус видит клиент
  comment        String?
  requirePayment Boolean    @default(false) // нельзя перевести, пока заказ не оплачен
  requireMaster  Boolean    @default(false) // нельзя перевести без мастера
  deadlineHours  Int? // сколько часов заказ может быть в статусе
  nextIds        String[]   @default([]) // куда можно перевести (цепочка)
  denySet        String[]   @default([]) // должности, которым нельзя ставить статус
  denySee        String[]   @default([]) // должности, которые не видят заказы в статусе
  denyEdit       String[]   @default([]) // должности, которые не могут менять заказ в статусе

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Order {
  id             String    @id @default(cuid())
  companyId      String
  locationId     String
  number         Int
  clientId       String
  statusId       String
  masterId       String?
  managerId      String?
  authorId       String
  orderType      String    @default("Платный")
  urgent         Boolean   @default(false)
  color          String?
  verdict        String? // вердикт / рекомендации клиенту
  discountPct    Int       @default(0)
  discountSum    Int       @default(0) // скидка в копейках
  deviceType     String
  brand          String?
  model          String?
  serial         String?
  problem        String
  equipment      String?
  appearance     String?
  notes          String?
  estimatedPrice Int?
  dueDate        DateTime?
  publicToken    String    @unique
  closedAt       DateTime?
  statusAt       DateTime? // когда поставлен текущий статус (для дедлайна)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location          @relation(fields: [companyId, locationId], references: [companyId, id])
  client   Client            @relation(fields: [companyId, clientId], references: [companyId, id])
  status   OrderStatus       @relation(fields: [companyId, statusId], references: [companyId, id])
  master   User?             @relation("OrderMaster", fields: [companyId, masterId], references: [companyId, id])
  manager  User?             @relation("OrderManager", fields: [companyId, managerId], references: [companyId, id])
  author   User              @relation("OrderAuthor", fields: [companyId, authorId], references: [companyId, id])
  items    OrderItem[]
  events   OrderEvent[]
  payments CashTransaction[]
  files    OrderFile[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, statusId])
  @@index([companyId, clientId])
}

model OrderItem {
  id           String   @id @default(cuid())
  companyId    String
  orderId      String
  kind         ItemKind
  productId    String?
  serviceId    String?
  name         String
  qty          Int      @default(1)
  price        Int // цена для клиента за единицу, коп.
  cost         Int      @default(0) // себестоимость за единицу, коп.
  warrantyDays Int? // гарантия на позицию, дней
  warehouseId  String? // со склада списана запчасть
  createdAt    DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [companyId, warehouseId], references: [companyId, id])
  order     Order      @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  product   Product?   @relation(fields: [companyId, productId], references: [companyId, id])
  service   Service?   @relation(fields: [companyId, serviceId], references: [companyId, id])

  @@index([companyId, orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  companyId String
  orderId   String
  userId    String?
  text      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  user    User?   @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([companyId, orderId])
}

model Service {
  id        String  @id @default(cuid())
  companyId String
  name      String
  price     Int
  isActive  Boolean @default(true)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Product {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  sku          String?
  barcode      String?
  price        Int // розничная цена (продажа), коп.
  repairPrice  Int? // ремонтная цена (в заказ), коп.
  minPrice     Int? // минимальная цена, ниже которой продавать нельзя, коп.
  cost         Int      @default(0) // средняя закупочная, коп.
  minQty       Int      @default(0)
  article      String? // артикул производителя
  unit         String   @default("шт")
  warrantyDays Int? // гарантия, дней
  country      String?
  description  String? // характеристики: память, цвет, состояние…
  isSerial     Boolean  @default(false) // серийный товар (IMEI / S/N)
  groupId      String?
  supplierId   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group      ProductGroup?  @relation(fields: [companyId, groupId], references: [companyId, id])
  supplier   Supplier?      @relation(fields: [companyId, supplierId], references: [companyId, id])
  docItems   StockDocItem[]
  stocks     Stock[]
  moves      StockMove[]
  orderItems OrderItem[]
  saleItems  SaleItem[]
  listings   Listing[]
  prices     ProductPrice[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Stock {
  id          String @id @default(cuid())
  companyId   String
  productId   String
  locationId  String // точка склада (для отчётов по точке)
  warehouseId String
  qty         Int    @default(0)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade)
  location  Location  @relation(fields: [companyId, locationId], references: [companyId, id])
  warehouse Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id])

  @@unique([companyId, productId, warehouseId])
  @@index([companyId, locationId])
}

model StockMove {
  id          String        @id @default(cuid())
  companyId   String
  productId   String
  locationId  String
  warehouseId String
  userId      String?
  type        StockMoveType
  qty         Int // + приход, - расход
  cost        Int           @default(0) // закупочная цена единицы при приходе
  comment     String?
  link        String? // документ, по которому было движение: /stock/docs/…, /sales/…, /orders/…
  createdAt   DateTime      @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade)
  location  Location  @relation(fields: [companyId, locationId], references: [companyId, id])
  warehouse Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id])
  user      User?     @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([companyId, productId])
  @@index([companyId, warehouseId, createdAt])
}

model CashTransaction {
  id          String    @id @default(cuid())
  companyId   String
  locationId  String
  cashboxId   String
  transferId  String? // общий id у двух половин перевода между кассами
  userId      String?
  orderId     String?
  saleId      String?
  amount      Int // + приход, - расход, коп.
  method      PayMethod @default(CASH)
  category    String // "Оплата заказа", "Продажа", "Аренда" ...
  comment     String?
  createdAt   DateTime  @default(now()) // дата выдачи: когда деньги ушли из кассы или пришли
  eventDate   DateTime? // дата события: за какой день операция (для отчётов), пусто — как дата выдачи
  stockDocId  String? // поступление или возврат поставщику, по которому платёж
  supplierId  String? // получатель — поставщик
  recipientId String? // получатель — сотрудник
  editedAt    DateTime?
  deletedAt   DateTime? // удалённая: сумма обнулена, исходная в origAmount
  origAmount  Int?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [companyId, locationId], references: [companyId, id])
  cashbox  Cashbox  @relation(fields: [companyId, cashboxId], references: [companyId, id])
  user     User?    @relation(fields: [companyId, userId], references: [companyId, id])
  order    Order?   @relation(fields: [companyId, orderId], references: [companyId, id])
  sale     Sale?    @relation(fields: [companyId, saleId], references: [companyId, id])

  @@index([companyId, locationId, createdAt])
  @@index([companyId, cashboxId, createdAt])
}

model Sale {
  id          String   @id @default(cuid())
  companyId   String
  locationId  String
  warehouseId String? // со склада продан товар
  number      Int
  clientId    String?
  userId      String?
  total       Int // у возврата сумма отрицательная
  discount    Int      @default(0) // скидка на чек, коп.
  isReturn    Boolean  @default(false)
  returnOfId  String? // возврат: исходная продажа
  bonusPaid   Int      @default(0) // оплачено баллами, коп.
  createdAt   DateTime @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location     Location          @relation(fields: [companyId, locationId], references: [companyId, id])
  warehouse    Warehouse?        @relation(fields: [companyId, warehouseId], references: [companyId, id])
  client       Client?           @relation(fields: [companyId, clientId], references: [companyId, id])
  user         User?             @relation(fields: [companyId, userId], references: [companyId, id])
  items        SaleItem[]
  transactions CashTransaction[]

  @@unique([companyId, id])
  @@unique([companyId, number])
}

model SaleItem {
  id        String @id @default(cuid())
  companyId String
  saleId    String
  productId String
  name      String
  qty       Int
  price     Int
  cost      Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Cascade)
  product Product @relation(fields: [companyId, productId], references: [companyId, id])

  @@index([companyId, saleId])
}

// Справочники для подсказок при приёмке: марки, модели, цвета, неисправности и т.д.
model DictItem {
  id        String   @id @default(cuid())
  companyId String
  kind      DictKind
  value     String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind, value])
  @@index([companyId, kind])
}

// Фото и файлы заказа. Хранятся в базе, чтобы попадать в ежедневный бэкап.
model OrderFile {
  id        String   @id @default(cuid())
  companyId String
  orderId   String
  name      String
  mime      String
  size      Int
  data      Bytes
  userId    String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, orderId])
}

// ---------- Скупка: источники объявлений, лента, выкуп ----------

enum ListingSourceKind {
  VK
  TELEGRAM
  AVITO
  YOULA
}

enum ListingStatus {
  NEW // пришло, никто не взял
  IN_WORK // сотрудник взял в работу
  BOUGHT // выкуплено
  REJECTED // не подошло
}

model ListingSource {
  id            String            @id @default(cuid())
  companyId     String
  kind          ListingSourceKind
  name          String
  url           String
  keywords      String            @default("") // через запятую; пусто — брать все посты
  stopWords     String            @default("") // через запятую; такие посты пропускаем
  isActive      Boolean           @default(true)
  lastCheckedAt DateTime?
  lastError     String?
  lastFound     Int               @default(0)
  createdAt     DateTime          @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([companyId, id])
  @@unique([companyId, url])
  @@index([companyId])
}

model Listing {
  id           String        @id @default(cuid())
  companyId    String
  sourceId     String? // null — добавлено вручную
  url          String
  title        String
  text         String        @default("")
  price        Int? // цена в объявлении, коп.
  photoUrl     String?
  postedAt     DateTime?
  status       ListingStatus @default(NEW)
  assigneeId   String?
  takenAt      DateTime?
  boughtAt     DateTime?
  buyPrice     Int? // за сколько выкупили, коп.
  productId    String? // товар на складе, созданный при выкупе
  rejectReason String?
  // что CRM поняла из текста объявления
  model        String?
  memoryGb     Int?
  batteryPct   Int?
  kit          String[]      @default([])
  defects      String[]      @default([])
  replacements String[]      @default([])
  condition    String? // NEW, EXCELLENT, GOOD, FAIR, REPAIR — как в оценке Авито
  color        String?
  parsedAt     DateTime?
  bonus        Int           @default(0) // фиксированный бонус, начисленный при выкупе, коп.
  createdAt    DateTime      @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source   ListingSource? @relation(fields: [companyId, sourceId], references: [companyId, id])
  assignee User?          @relation("ListingAssignee", fields: [companyId, assigneeId], references: [companyId, id])
  product  Product?       @relation(fields: [companyId, productId], references: [companyId, id])

  @@unique([companyId, id])
  @@unique([companyId, url])
  @@index([companyId, status, createdAt])
  @@index([companyId, assigneeId])
  @@index([companyId, model, memoryGb])
}

// Снимок рынка за день по модели и памяти: из него строятся таблица «Рынок» и графики.
model MarketSnapshot {
  id        String   @id @default(cuid())
  companyId String
  model     String
  memoryGb  Int
  day       DateTime @db.Date
  median    Int // коп.
  low       Int // нижняя четверть цен, коп.
  high      Int // верхняя четверть цен, коп.
  count     Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, model, memoryGb, day])
  @@index([companyId, day])
}

// ---------- Склад: группы, поставщики, документы ----------

model ProductGroup {
  id        String  @id @default(cuid())
  companyId String
  name      String
  parentId  String?
  sort      Int     @default(0)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductGroup?  @relation("GroupTree", fields: [companyId, parentId], references: [companyId, id])
  children ProductGroup[] @relation("GroupTree")
  products Product[]

  @@unique([companyId, id])
  @@index([companyId])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  docs     StockDoc[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model StockDoc {
  id            String       @id @default(cuid())
  companyId     String
  number        Int
  type          StockDocType
  locationId    String
  toLocationId  String?
  warehouseId   String
  toWarehouseId String?
  supplierId    String?
  clientId      String? // поступление от клиента (принёс свою технику)
  userId        String?
  responsibleId String? // ответственный за документ
  inDocNo       String? // входящий документ: номер накладной поставщика
  inDocDate     DateTime?
  paid          Int          @default(0) // оплачено поставщику/клиенту, коп.
  comment       String?
  total         Int          @default(0) // сумма по закупке, коп.
  createdAt     DateTime     @default(now())

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location    Location       @relation("DocFrom", fields: [companyId, locationId], references: [companyId, id])
  toLocation  Location?      @relation("DocTo", fields: [companyId, toLocationId], references: [companyId, id])
  warehouse   Warehouse      @relation("WhFrom", fields: [companyId, warehouseId], references: [companyId, id])
  toWarehouse Warehouse?     @relation("WhTo", fields: [companyId, toWarehouseId], references: [companyId, id])
  supplier    Supplier?      @relation(fields: [companyId, supplierId], references: [companyId, id])
  client      Client?        @relation(fields: [companyId, clientId], references: [companyId, id])
  items       StockDocItem[]

  @@unique([companyId, id])
  @@index([companyId, createdAt])
}

model StockDocItem {
  id      String  @id @default(cuid())
  serials String? // серийные номера (IMEI / S/N) через запятую

  companyId String
  docId     String
  productId String
  name      String
  qty       Int // для инвентаризации — разница (факт минус учёт)
  cost      Int    @default(0)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doc     StockDoc @relation(fields: [companyId, docId], references: [companyId, id], onDelete: Cascade)
  product Product  @relation(fields: [companyId, productId], references: [companyId, id])

  @@index([companyId, docId])
}

// Кассовая смена на точке: открытие с остатком наличных, закрытие с пересчётом.
model CashShift {
  id           String    @id @default(cuid())
  companyId    String
  locationId   String
  cashboxId    String
  openedById   String?
  closedById   String?
  openCash     Int       @default(0) // наличные на начало, коп.
  expectedCash Int? // по учёту на момент закрытия
  closeCash    Int? // пересчитали фактически
  comment      String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [companyId, locationId], references: [companyId, id])
  cashbox  Cashbox  @relation(fields: [companyId, cashboxId], references: [companyId, id])

  @@index([companyId, locationId, openedAt])
  @@index([companyId, cashboxId, openedAt])
}

// Должность: название и набор прав. Тип доступа (baseRole) нужен для списков мастеров.
model Position {
  id        String   @id @default(cuid())
  companyId String
  name      String
  baseRole  Role     @default(MANAGER)
  perms     String[]
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@unique([companyId, id])
  @@index([companyId])
}

// Касса: наличные в точке, карта, расчётный счёт и т.д. Может быть общей для всех точек.
model Cashbox {
  id         String   @id @default(cuid())
  companyId  String
  locationId String? // null — касса компании, видна во всех точках
  name       String
  isActive   Boolean  @default(true)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location     Location?         @relation(fields: [companyId, locationId], references: [companyId, id])
  warehouses   Warehouse[]
  transactions CashTransaction[]
  shifts       CashShift[]

  @@unique([companyId, id])
  @@index([companyId])
}

// Склад внутри точки: запчасти, аксессуары, б/у техника, айфоны...
model Warehouse {
  id         String   @id @default(cuid())
  companyId  String
  locationId String
  cashboxId  String? // касса по умолчанию для продаж с этого склада
  name       String
  isActive   Boolean  @default(true)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location   Location    @relation(fields: [companyId, locationId], references: [companyId, id])
  cashbox    Cashbox?    @relation(fields: [companyId, cashboxId], references: [companyId, id])
  stocks     Stock[]
  moves      StockMove[]
  docsFrom   StockDoc[]  @relation("WhFrom")
  docsTo     StockDoc[]  @relation("WhTo")
  orderItems OrderItem[]
  sales      Sale[]

  @@unique([companyId, id])
  @@index([companyId])
}

// Журнал действий сотрудников: кто, что и когда сделал.
model ActionLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  locationId String?
  cashboxId  String?
  kind       String // cash, sale, order, stock, settings, users
  text       String
  amount     Int?
  link       String? // ссылка на объект в CRM
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([companyId, createdAt])
}

// Дополнительные виды цен (рассрочка, опт и т.д.). Розничная, ремонтная, минимальная
// и закупочная хранятся в самом товаре.
model PriceType {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  forProducts Boolean  @default(true)
  forWorks    Boolean  @default(false)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices  ProductPrice[]

  @@unique([companyId, id])
  @@index([companyId])
}

model ProductPrice {
  id          String @id @default(cuid())
  companyId   String
  productId   String
  priceTypeId String
  value       Int // коп.

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade)
  priceType PriceType @relation(fields: [companyId, priceTypeId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, productId, priceTypeId])
}

// Печатная форма: HTML с переменными вида <НомерДокумента>.
model PrintTemplate {
  id        String   @id @default(cuid())
  companyId String
  docType   String // order, sale, receipt, supplier_return, writeoff, transfer, inventory, client_report, price_tag, salary, invoice
  name      String
  html      String
  pageSize  String   @default("A4") // A4, A5, … или custom
  width     Int? // мм, для своих размеров
  height    Int?
  landscape Boolean  @default(false)
  margins   Int[]    @default([10, 10, 10, 10]) // верх, право, низ, лево, мм
  separate  Boolean  @default(false) // печатать отдельно от других
  isDefault Boolean  @default(false)
  sort      Int      @default(0)
  source    String? // ключ исходного бланка (для обновлений)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, docType])
}

// Правило начисления зарплаты сотруднику.
model SalaryRule {
  id               String   @id @default(cuid())
  companyId        String
  userId           String
  kind             String // SALE — за продажу, WORK — за выполненную работу (заказ)
  base             String   @default("PROFIT") // PROFIT — от валовой прибыли, REVENUE — от выручки
  percent          Int      @default(0) // сотые доли процента: 700 = 7%
  fixed            Int      @default(0) // фикс за продажу/заказ, коп.
  minBase          Int      @default(0) // начислять, если база ≥, коп.
  maxAmount        Int? // не более, коп.
  locationId       String? // пусто — все точки
  orderType        String? // пусто — все типы заказа
  includeWorks     Boolean  @default(true)
  includeParts     Boolean  @default(true)
  subtractNegative Boolean  @default(true)
  keepOnReturn     Boolean  @default(false)
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, userId])
}

// Ручные записи по зарплате: бонус, штраф, выплата.
// Плитки на экране продажи: PRIORITY — что начальство просит продать, FREQUENT — закреплённые частые товары.
model SaleTile {
  id        String @id @default(cuid())
  companyId String
  side      String // PRIORITY или FREQUENT
  slot      Int // 0..3
  productId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, side, slot])
}

// История изменений кассовой операции: создание, правка, удаление.
model CashTxLog {
  id        String   @id @default(cuid())
  companyId String
  txId      String
  userId    String?
  action    String // CREATE, EDIT, DELETE
  amount    Int
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, txId])
}

model SalaryEntry {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  kind        String // BONUS, FINE, PAYOUT
  amount      Int // коп., всегда положительное
  comment     String?
  cashTxId    String? // выплата из кассы
  locationId  String?
  createdById String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, userId, date])
}

// ---- Платформа (видит только владелец сервиса) ----

// Вход владельца платформы в данные компании с её разрешения (152-ФЗ: каждый вход записывается).
model SupportLog {
  id        String    @id @default(cuid())
  companyId String
  adminId   String // пользователь — владелец платформы
  adminName String
  write     Boolean   @default(false) // были ли разрешены изменения
  reason    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startedAt])
  @@index([startedAt])
}

// Одноразовые ссылки-приглашения для регистрации новой мастерской.
model PlatformInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  note      String? // кому выдано
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  companyId String? // какая компания зарегистрировалась по ссылке
}

// Проверка работы сайта раз в минуту.
model HealthSample {
  id    String   @id @default(cuid())
  at    DateTime @default(now())
  ok    Boolean
  ms    Int // время ответа сайта
  dbMs  Int? // время ответа базы
  error String?

  @@index([at])
}

// Ошибки сервера и запуски приложения.
model PlatformEvent {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  kind    String // error, start
  message String
  path    String?
  detail  String?

  @@index([kind, at])
}

enum BonusKind {
  ACCRUE // начислено за покупку или заказ
  SPEND // оплачено баллами
  EXPIRE // сгорели
  WELCOME // приветственные при регистрации
  MANUAL // вручную владельцем
  RETURN // отмена по возврату
}

// Движение бонусных баллов клиента. Баланс — сумма amount (коп., 1 балл = 1 ₽).
model BonusTx {
  id         String    @id @default(cuid())
  companyId  String
  clientId   String
  kind       BonusKind
  amount     Int // + начисление, - списание
  saleId     String?
  orderId    String?
  userId     String?
  comment    String?
  activeFrom DateTime  @default(now()) // с какого момента баллы можно тратить
  expiresAt  DateTime? // когда сгорают
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, clientId, createdAt])
}
